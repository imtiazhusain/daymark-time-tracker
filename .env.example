# Required: MongoDB Atlas SRV connection string. URL-encode reserved password characters.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/time-tracker?retryWrites=true&w=majority

SCREENSHOT_INTERVAL_SECONDS=300
HEARTBEAT_SECONDS=30
SCREENSHOT_DIR=./screenshots
OCR_LANGUAGE=eng
OCR_ENABLED=true
IMAGE_MAX_WIDTH=1280
IMAGE_QUALITY=60
OCR_IDLE_TERMINATE_SECONDS=300
